<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Target Shooter</title>

<style>
* {
  box-sizing: border-box;
  user-select: none;
}

body {
  margin: 0;
  background: #08090d;
  color: white;
  font-family: Arial, sans-serif;
  overflow: hidden;
}

#menu {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #08090d, #181b25);
  z-index: 10;
}

#menu h1 {
  font-size: 42px;
  margin-bottom: 10px;
}

#menu p {
  color: #aaa;
  margin-bottom: 25px;
}

button {
  border: 0;
  border-radius: 12px;
  padding: 15px 35px;
  font-size: 18px;
  font-weight: bold;
  background: #e53935;
  color: white;
}

#game {
  position: fixed;
  inset: 0;
  display: none;
}

#hud {
  position: fixed;
  top: 15px;
  left: 15px;
  right: 15px;
  display: flex;
  justify-content: space-between;
  font-size: 20px;
  font-weight: bold;
  z-index: 3;
}

#arena {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(#11151c 1px, transparent 1px),
    linear-gradient(90deg, #11151c 1px, transparent 1px);
  background-size: 40px 40px;
}

.target {
  position: absolute;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: #e53935;
  border: 8px solid white;
  box-shadow: 0 0 20px rgba(255,255,255,.25);
}

.target::after {
  content: "";
  position: absolute;
  width: 22px;
  height: 22px;
  background: white;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

#message {
  position: fixed;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%);
  color: #aaa;
  font-size: 15px;
}
</style>
</head>

<body>

<div id="menu">
  <h1>🎯 Target Shooter</h1>
  <p>Acerta o máximo de alvos que conseguir.</p>
  <button onclick="startGame()">INICIAR</button>
</div>

<div id="game">
  <div id="hud">
    <span>Pontos: <span id="score">0</span></span>
    <span>Tempo: <span id="time">30</span>s</span>
  </div>

  <div id="arena"></div>

  <div id="message">
    Toque nos alvos vermelhos
  </div>
</div>

<script>
let score = 0;
let time = 30;
let timer;
let target;

function startGame() {
  score = 0;
  time = 30;

  document.getElementById("score").textContent = score;
  document.getElementById("time").textContent = time;

  document.getElementById("menu").style.display = "none";
  document.getElementById("game").style.display = "block";

  createTarget();

  clearInterval(timer);

  timer = setInterval(() => {
    time--;

    document.getElementById("time").textContent = time;

    if (time <= 0) {
      endGame();
    }
  }, 1000);
}

function createTarget() {
  if (target) {
    target.remove();
  }

  target = document.createElement("div");
  target.className = "target";

  const maxX = window.innerWidth - 90;
  const maxY = window.innerHeight - 100;

  const x = Math.random() * maxX + 10;
  const y = Math.random() * maxY + 50;

  target.style.left = x + "px";
  target.style.top = y + "px";

  target.onclick = () => {
    score++;
    document.getElementById("score").textContent = score;
    createTarget();
  };

  document.getElementById("arena").appendChild(target);
}

function endGame() {
  clearInterval(timer);

  if (target) {
    target.remove();
    target = null;
  }

  document.getElementById("game").style.display = "none";
  document.getElementById("menu").style.display = "flex";

  document.querySelector("#menu p").textContent =
    "Fim de jogo! Você fez " + score + " pontos.";

  document.querySelector("#menu button").textContent = "JOGAR NOVAMENTE";
}
</script>

</body>
</html>